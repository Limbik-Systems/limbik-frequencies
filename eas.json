{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "image": "sdk-54"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "image": "sdk-54"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "image": "sdk-54"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6833770475"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
